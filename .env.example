# Port to bind production application server
PORT=3000

# Network host binding (Use 127.0.0.1 for local/Nginx reverse proxy, 0.0.0.0 for open network)
HOST=127.0.0.1

# Environment Mode
NODE_ENV=production

# Application UI Customizations (Vite dynamic vars must start with VITE_)
VITE_APP_TITLE="ระบบคำนวณค่าทางด่วนและโทลล์เวย์ไทย - Thai Expressway & Tollway Fare Calculator"
VITE_APP_ENV=production
